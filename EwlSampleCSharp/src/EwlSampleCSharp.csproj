<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{1d91ee6d-1694-44c1-adde-980b4ca7535d}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>EwlSampleCSharp</RootNamespace>
    <AssemblyName>EwlSampleCSharp</AssemblyName>
    <TargetFrameworkVersion>v3.5</TargetFrameworkVersion>
    <TargetFrameworkProfile>Unity Full v3.5</TargetFrameworkProfile>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>
  <PropertyGroup>
    <!-- このリポジトリが Besiege_Data/Mods/ の下にある前提 -->
    <BESIEGE_ASSEMBLIES>..\..\..\..\Managed\</BESIEGE_ASSEMBLIES>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(BESIEGE_ASSEMBLIES)Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(BESIEGE_ASSEMBLIES)UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- EWL は参照するだけで同梱しない(利用者が EWL を別に導入する) -->
    <Reference Include="EsWeaponsLib">
      <HintPath>..\..\EsWeaponsLib\EsWeaponsLib.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="SampleMod.cs" />
    <Compile Include="SampleCannonModule.cs" />
    <Compile Include="SampleCannonBehaviour.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="CopyToModFolder" AfterTargets="PostBuildEvent">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProjectDir).." />
  </Target>
</Project>
